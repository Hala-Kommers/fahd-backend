{
  "info": {
    "name": "Fahd Backend Unified API",
    "description": "Unified collection for storefront, auth, and admin APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "productId", "value": "1" },
    { "key": "orderId", "value": "1" },
    { "key": "conversationId", "value": "1" },
    { "key": "couponCode", "value": "WELCOME10" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"ok\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "POST /api/auth/refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/refresh"
          }
        },
        {
          "name": "POST /api/auth/logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/logout"
          }
        },
        {
          "name": "GET /api/auth/me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Storefront",
      "item": [
        {
          "name": "GET /api/products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?page=1&limit=12&search=oud&category=perfumes&sort=price_desc"
          }
        },
        {
          "name": "GET /api/products/:id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/{{productId}}"
          }
        },
        {
          "name": "GET /api/categories",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/categories" }
        },
        {
          "name": "POST /api/coupons/validate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{couponCode}}\",\n  \"subtotal\": 250\n}"
            },
            "url": "{{baseUrl}}/api/coupons/validate"
          }
        },
        {
          "name": "POST /api/orders",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"COD\",\n  \"customerName\": \"Ahmed\",\n  \"customerPhone\": \"+966500000000\",\n  \"customerEmail\": \"ahmed@example.com\",\n  \"addressRaw\": \"Riyadh, Al Malqa\",\n  \"addressCity\": \"Riyadh\",\n  \"couponCode\": \"WELCOME10\",\n  \"items\": [\n    {\"productId\": 1, \"qty\": 1}\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/orders"
          }
        },
        {
          "name": "GET /api/orders/:id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/{{orderId}}"
          }
        },
        {
          "name": "POST /api/chat/start",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/chat/start" }
        },
        {
          "name": "POST /api/chat/message",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": {{conversationId}},\n  \"message\": \"Do you have oud offers?\"\n}"
            },
            "url": "{{baseUrl}}/api/chat/message"
          }
        }
      ]
    },
    {
      "name": "Admin Products",
      "item": [
        {
          "name": "GET /api/admin/products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/admin/products?page=1&limit=20&status=active"
          }
        },
        {
          "name": "GET /api/admin/products/:id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/admin/products/{{productId}}"
          }
        },
        {
          "name": "POST /api/admin/products",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Saffron Musk\",\n  \"slug\": \"saffron-musk\",\n  \"sku\": \"P-2001\",\n  \"status\": \"active\",\n  \"category\": {\"id\": 1},\n  \"descriptionShort\": \"Fresh saffron notes\",\n  \"descriptionLong\": \"A luxurious blend of saffron and white musk.\",\n  \"pricing\": {\"cost\": 70, \"price\": 145, \"compareAt\": 190, \"currency\": \"SAR\"},\n  \"inventory\": {\"mode\": \"global\", \"stockTotal\": 80, \"lowStockThreshold\": 10},\n  \"isFeatured\": true,\n  \"hasVariants\": true,\n  \"variantOptions\": [\"size\"],\n  \"specs\": [{\"key\":\"volume\",\"value\":\"75ml\"}],\n  \"faq\": [{\"question\":\"Is it unisex?\",\"answer\":\"Yes\"}],\n  \"usageInstructions\": \"Apply to pulse points.\",\n  \"pricingTiers\": [{\"qty\":1,\"label\":\"قطعة واحدة\",\"originalPrice\":190,\"finalPrice\":145}],\n  \"images\": [{\"url\":\"https://cdn.example.com/products/p2001-main.jpg\",\"isPrimary\":true,\"sortOrder\":0}],\n  \"variants\": [{\"sku\":\"P-2001-75ML\",\"attributes\":{\"size\":\"75ml\"},\"priceOverride\":145,\"stock\":80,\"isActive\":true}]\n}"
            },
            "url": "{{baseUrl}}/api/admin/products"
          }
        },
        {
          "name": "PATCH /api/admin/products/:id",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Saffron Musk Updated\",\n  \"slug\": \"saffron-musk\",\n  \"sku\": \"P-2001\",\n  \"status\": \"active\",\n  \"category\": {\"id\": 1},\n  \"descriptionShort\": \"Updated short\",\n  \"descriptionLong\": \"Updated long\",\n  \"pricing\": {\"cost\": 72, \"price\": 149, \"compareAt\": 199, \"currency\": \"SAR\"},\n  \"inventory\": {\"mode\": \"variant\", \"stockTotal\": 90, \"lowStockThreshold\": 10},\n  \"isFeatured\": false,\n  \"hasVariants\": true,\n  \"variantOptions\": [\"size\"],\n  \"specs\": [{\"key\":\"volume\",\"value\":\"75ml\"}],\n  \"faq\": [{\"question\":\"Is it unisex?\",\"answer\":\"Yes\"}],\n  \"usageInstructions\": \"Updated usage\",\n  \"pricingTiers\": [{\"qty\":1,\"label\":\"قطعة واحدة\",\"originalPrice\":199,\"finalPrice\":149}],\n  \"images\": [{\"url\":\"https://cdn.example.com/products/p2001-main-new.jpg\",\"isPrimary\":true,\"sortOrder\":0}],\n  \"variants\": [{\"sku\":\"P-2001-75ML\",\"attributes\":{\"size\":\"75ml\"},\"priceOverride\":149,\"stock\":90,\"isActive\":true}]\n}"
            },
            "url": "{{baseUrl}}/api/admin/products/{{productId}}"
          }
        },
        {
          "name": "DELETE /api/admin/products/:id",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/admin/products/{{productId}}"
          }
        }
      ]
    }
  ]
}
